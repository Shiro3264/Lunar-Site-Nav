# ============================================================
# LunaNav — .gitignore
# ============================================================

# ------------------------------------------------------------
# Root-level working files (not part of the project)
# ------------------------------------------------------------
New Text Document.txt
*.rar
*.zip
*.tar.gz

# ------------------------------------------------------------
# Python — backend
# ------------------------------------------------------------

# Virtual environments (both Windows and Linux versions)
lunar_landing_website/backend/.venv/
lunar_landing_website/backend/.venv (linux)/

# Compiled Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
.eggs/

# pytest cache
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Django
lunar_landing_website/backend/db.sqlite3
lunar_landing_website/backend/staticfiles/
lunar_landing_website/backend/mediafiles/

# Secret environment file — NEVER commit real secrets
lunar_landing_website/backend/.env

# Scientific data — large binary files, not for version control
# Download instructions are in the README.
lunar_landing_website/backend/scientific_data/lola/
lunar_landing_website/backend/scientific_data/spice/

# Keep the directories themselves so the structure is obvious on clone
!lunar_landing_website/backend/scientific_data/lola/.gitkeep
!lunar_landing_website/backend/scientific_data/spice/.gitkeep

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------
# Node / frontend
# ------------------------------------------------------------

# Dependencies — restored with `npm install`
lunar_landing_website/frontend/node_modules/

# Vite build output
lunar_landing_website/frontend/dist/

# TypeScript incremental build info
lunar_landing_website/frontend/tsconfig.tsbuildinfo
lunar_landing_website/frontend/tsconfig.node.tsbuildinfo

# Compiled JS versions of config files (auto-generated by Vite)
lunar_landing_website/frontend/vite.config.js
lunar_landing_website/frontend/vite.config.d.ts

# Playwright
lunar_landing_website/frontend/playwright-report/
lunar_landing_website/frontend/test-results/

# Frontend environment file — NEVER commit real API keys
lunar_landing_website/frontend/.env

# ------------------------------------------------------------
# OS and editor noise
# ------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code / Kiro
.vscode/
.kiro/

# JetBrains IDEs
.idea/

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
