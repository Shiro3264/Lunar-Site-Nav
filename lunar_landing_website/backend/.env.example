# ============================================================
# LunaNav backend — environment variables
# Copy this file to .env and fill in values before running.
# ============================================================

# ----------------------------------------------------------
# Django core
# ----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# PostgreSQL (leave all POSTGRES_* blank to use SQLite)
# ----------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ----------------------------------------------------------
# CORS / CSRF
# ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# Cache
# ----------------------------------------------------------
# TTL for in-process cache entries (seconds). Default 3600.
CACHE_TIMEOUT=3600

# ----------------------------------------------------------
# API throttling
# ----------------------------------------------------------
API_THROTTLE_ANON=240/min
API_THROTTLE_HORIZONS=60/min

# ----------------------------------------------------------
# JPL Horizons
# ----------------------------------------------------------
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
HORIZONS_TIMEOUT=30
HORIZONS_MAX_RETRIES=3
HORIZONS_CACHE_TTL=3600
HORIZONS_STORE_RAW=true

# ----------------------------------------------------------
# NASA LOLA DEM tiles
# Place GeoTIFF / JP2 tiles here; leave blank to run without
# measured terrain (synthetic placeholder is used instead).
# ----------------------------------------------------------
LOLA_DEM_DIR=scientific_data/lola

# ----------------------------------------------------------
# NAIF SPICE kernels
# Required files (placed in SPICE_KERNEL_DIR):
#   naif0012.tls
#   pck00010.tpc
#   moon_de440_250416.tf
#   moon_pa_de440_200625.bpc
# Download from: https://naif.jpl.nasa.gov/naif/data.html
# Without them the backend falls back to a linear IAU_MOON
# approximation (confidence = "low", clearly labelled).
# ----------------------------------------------------------
SPICE_KERNEL_DIR=scientific_data/spice

# ----------------------------------------------------------
# Misc
# ----------------------------------------------------------
LOG_LEVEL=INFO
MAX_TIMELINE_STEPS=720
